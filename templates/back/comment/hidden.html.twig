{% extends 'base.html.twig' %}

{% block title %}Commentaires masqués — Auparavant Admin{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-eye-slash"></i>
                Commentaires masqués
            </h1>
            <div class="breadcrumb">
                <a href="{{ path('app_main') }}">Accueil</a>
                <i class="bi bi-chevron-right"></i>
                <span>Commentaires masqués</span>
            </div>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-card-header">
            <h3><i class="bi bi-eye-slash"></i> Commentaires retirés de l'affichage public</h3>
            <span class="badge badge-warning">{{ total }} masqué{{ total > 1 ? 's' : '' }}</span>
        </div>
        <div class="admin-card-body" style="padding: 0;">
            {% if comments is not empty %}
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">ID</th>
                            <th>Commentaire</th>
                            <th>Souvenir</th>
                            <th>Masqué</th>
                            <th style="width: 320px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for comment in comments %}
                            <tr>
                                <td><span class="badge badge-primary">#{{ comment.id }}</span></td>
                                <td>
                                    <p style="white-space: pre-wrap; margin: 6px 0;">{{ comment.content }}</p>
                                    <small>
                                        {% if comment.author %}
                                            par {{ comment.author.pseudonym }}
                                        {% else %}
                                            par un utilisateur supprimé
                                        {% endif %}
                                        — {{ comment.createdAt|date('d/m/Y H:i') }}
                                        {% if comment.parent %} · réponse au commentaire #{{ comment.parent.id }}{% endif %}
                                    </small>
                                </td>
                                <td>
                                    <a href="{{ path('app_memory_show', {'id': comment.memory.id}) }}" style="color: var(--accent);">
                                        <i class="bi bi-camera-reels"></i>
                                        {{ comment.memory.title|default('Souvenir #' ~ comment.memory.id) }}
                                    </a>
                                </td>
                                <td>
                                    {% if comment.hiddenAt %}{{ comment.hiddenAt|date('d/m/Y H:i') }}{% else %}<span style="color: var(--text-muted);">date inconnue</span>{% endif %}
                                    <br>
                                    <small>
                                        {% if comment.hiddenBy %}par {{ comment.hiddenBy.pseudonym }}{% else %}par un modérateur inconnu{% endif %}
                                    </small>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <form method="post" action="{{ path('app_comment_unhide', {'id': comment.id}) }}" style="display: flex; flex-direction: column; gap: 4px; width: 100%;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('unhide' ~ comment.id) }}">
                                            {{ include('back/_moderation_fields.html.twig', {key: 'unhide' ~ comment.id}) }}
                                            <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-eye"></i> Démasquer</button>
                                        </form>
                                        <form method="post" action="{{ path('app_comment_hidden_delete', {'id': comment.id}) }}" onsubmit="return confirm('Supprimer définitivement ce commentaire ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-hidden' ~ comment.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if pages > 1 %}
                    <div style="padding: 12px; display: flex; gap: 8px; align-items: center;">
                        {% if page > 1 %}<a class="btn btn-sm btn-outline" href="{{ path('app_comment_hidden_index', {'page': page - 1}) }}">Précédent</a>{% endif %}
                        <span>Page {{ page }} / {{ pages }}</span>
                        {% if page < pages %}<a class="btn btn-sm btn-outline" href="{{ path('app_comment_hidden_index', {'page': page + 1}) }}">Suivant</a>{% endif %}
                    </div>
                {% endif %}
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-check2-circle"></i>
                    <h4>Aucun commentaire masqué</h4>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock content %}
