{% extends 'base.html.twig' %}

{% block title %}
	{{ memory.title|default('Souvenir') }}
	— Auparavant Admin
{% endblock %}

{% block content %}
	<div class="page-header">
		<div>
			<h1 class="page-title">
				<i class="bi bi-camera-reels"></i>
				{{ memory.title|default('Souvenir #' ~ memory.id) }}
			</h1>
			<div class="breadcrumb">
				<a href="{{ path('app_main') }}">Accueil</a>
				<i class="bi bi-chevron-right"></i>
				<a href="{{ path('app_memory_index') }}">Souvenirs</a>
				<i class="bi bi-chevron-right"></i>
				<span>#{{ memory.id }}</span>
			</div>
		</div>
		<div class="action-buttons">
			<a href="{{ path('app_memory_edit', {'id': memory.id}) }}" class="btn btn-warning">
				<i class="bi bi-pencil"></i>
				Modifier
			</a>
			<a href="{{ path('app_memory_index') }}" class="btn btn-secondary">
				<i class="bi bi-arrow-left"></i>
				Retour
			</a>
		</div>
	</div>

	<div
		class="d-flex gap-2" style="flex-wrap: wrap;">
		<!-- Photos -->
		{% if memory.pictures is not empty %}
			<div class="admin-card" style="flex: 0 0 300px;">
				<div class="admin-card-header">
					<h3>
						<i class="bi bi-images"></i>
						Photos
					</h3>
					<span class="badge badge-primary">{{ memory.pictures|length }}</span>
				</div>
				<div class="admin-card-body">
					{% if firstPicture %}
						<img id="mainPicture" src="{{ firstPicture.imageUrl }}" class="img-preview mb-2" alt="{{ firstPicture.type ?? 'Photo' }}" style="width: 100%; height: auto; max-height: 300px; object-fit: cover;">
					{% endif %}

					{% if memory.pictures|length > 1 %}
						<div class="d-flex gap-2 flex-wrap mt-2">
							{% for picture in memory.pictures|slice(1) %}
								<img src="{{ picture.imageUrl }}" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover; cursor: pointer;" alt="{{ picture.type ?? 'Photo' }}" onclick="swapPictures(this, document.getElementById('mainPicture'))">
							{% endfor %}
						</div>
					{% endif %}
				</div>
			</div>
		{% else %}
			<div class="admin-card" style="flex: 0 0 300px;">
				<div class="admin-card-header">
					<h3>
						<i class="bi bi-images"></i>
						Photos
					</h3>
				</div>
				<div class="admin-card-body text-center">
					<div class="empty-state" style="padding: 2rem;">
						<i class="bi bi-image"></i>
						<p>Aucune photo</p>
					</div>
				</div>
			</div>
		{% endif %}

		<!-- Informations -->
		<div class="admin-card" style="flex: 1; min-width: 300px;">
			<div class="admin-card-header">
				<h3>
					<i class="bi bi-info-circle"></i>
					Informations
				</h3>
			</div>
			<div class="admin-card-body">
				<table class="admin-table" style="margin: -1.5rem;">
					<tbody>
						<tr>
							<th style="width: 150px;">ID</th>
							<td>
								<span class="badge badge-primary">#{{ memory.id }}</span>
							</td>
						</tr>
						<tr>
							<th>Titre</th>
							<td>
								<strong>{{ memory.title|default('—') }}</strong>
							</td>
						</tr>
						<tr>
							<th>Contenu</th>
							<td>{{ memory.content|default('—') }}</td>
						</tr>
						<tr>
							<th>Date de la photo</th>
							<td>{{ memory.pictureDate ? memory.pictureDate|date('d/m/Y') : '—' }}</td>
						</tr>
						<tr>
							<th>Année</th>
							<td>{{ memory.year ?? '—' }}</td>
						</tr>
						<tr>
							<th>Lieu</th>
							<td>
								{% if memory.place %}
									<a href="{{ path('app_place_show', {'id': memory.place.id}) }}" class="btn btn-sm btn-secondary">
										<i class="bi bi-building"></i>
										{{ memory.place.name }}
										({{ memory.place.type.label }})
									</a>
								{% else %}
									<span style="color: var(--text-muted);">—</span>
								{% endif %}
							</td>
						</tr>
						<tr>
							<th>Localisation</th>
							<td>
								{% if memory.location %}
									<a href="{{ path('app_location_show', {'id': memory.location.id}) }}" class="btn btn-sm btn-secondary">
										<i class="bi bi-geo-alt"></i>
										{{ memory.location.street }},
										{{ memory.location.zipcode }}
										{{ memory.location.city }}
									</a>
								{% else %}
									<span style="color: var(--text-muted);">—</span>
								{% endif %}
							</td>
						</tr>
						<tr>
							<th>Auteur</th>
							<td>
								{% if memory.user %}
									{{ memory.user.pseudonym }}
								{% else %}
									<span style="color: var(--text-muted);">—</span>
								{% endif %}
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Galerie complète des photos -->
	{% if memory.pictures|length > 1 %}
		<div class="admin-card mt-3">
			<div class="admin-card-header">
				<h3>
					<i class="bi bi-images"></i>
					Galerie complète
				</h3>
				<span class="badge badge-primary">{{ memory.pictures|length }}
					photo(s)</span>
			</div>
			<div class="admin-card-body">
				<div class="row d-flex flex-row">
					{% for picture in memory.pictures %}
						<div class="col-md-2">
							<div class="card d-flex flex-row">
								<img src="{{ picture.imageUrl }}" class="card-img-top" alt="{{ picture.type ?? 'Photo' }}" style="height: 120px; object-fit: cover; border-radius:5%">
								<div class="card-body p-2 d-flex align-items-center justify-content-center gap-2">
									<a href="{{ path('app_picture_show', {'id': picture.id}) }}" class="btn btn-sm btn-secondary">
										<i class="bi bi-eye"></i>
									</a>
								</div>
							</div>
						</div>

					{% endfor %}
				</div>
			</div>
		</div>
	{% endif %}

	<!-- Zone de danger -->
	<div class="admin-card mt-3" style="border-color: rgba(139, 0, 0, 0.3);">
		<div class="admin-card-header" style="background: rgba(139, 0, 0, 0.1);">
			<h3 style="color: #CD5C5C;">
				<i class="bi bi-exclamation-triangle"></i>
				Zone de danger
			</h3>
		</div>
		<div class="admin-card-body">
			<p style="color: var(--text-secondary)">
				La suppression de ce souvenir est irréversible.
			</p>
			<small style="color: var(--text-secondary); margin: 1rem 0;">
				<i>Elle engendre également la suppression des éléments associés, notamment les photos. Si le souvenir est le dernier d'un lieu alors ce dernier est aussi supprimé.</i>
			</small>
			{{ include('back/memory/_delete_form.html.twig') }}
		</div>
	</div>

	<script>
		function swapPictures(thumbnail, mainPicture) { // Échange les sources
const tempSrc = mainPicture.src;
mainPicture.src = thumbnail.src;
thumbnail.src = tempSrc;
}
	</script>

{% endblock content %}
