{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur — Auparavant Admin{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-pencil"></i>
                Modifier l'utilisateur
            </h1>
            <div class="breadcrumb">
                <a href="{{ path('app_main') }}">Accueil</a>
                <i class="bi bi-chevron-right"></i>
                <a href="{{ path('app_user_index') }}">Utilisateurs</a>
                <i class="bi bi-chevron-right"></i>
                <span>#{{ user.id }}</span>
            </div>
        </div>
        <div class="action-buttons">
            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-secondary">
                <i class="bi bi-eye"></i>
                Voir
            </a>
            <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Retour
            </a>
        </div>
    </div>
    
    <div class="admin-card">
        <div class="admin-card-header">
            <h3><i class="bi bi-person"></i> Informations de l'utilisateur</h3>
        </div>
        <div class="admin-card-body">
            {{ include('back/user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
    
    <!-- Zone de danger -->
    <div class="admin-card mt-3" style="border-color: rgba(139, 0, 0, 0.3);">
        <div class="admin-card-header" style="background: rgba(139, 0, 0, 0.1);">
            <h3 style="color: #CD5C5C;"><i class="bi bi-exclamation-triangle"></i> Zone de danger</h3>
        </div>
        <div class="admin-card-body">
            <p style="color: var(--text-secondary); margin-bottom: 1rem;">
                La suppression de cet utilisateur est irréversible.
            </p>
            {{ include('back/user/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock content %}
