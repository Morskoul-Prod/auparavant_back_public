{% extends 'base.html.twig' %}

{% block title %}Nouveau lieu — Auparavant Admin{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-plus-circle"></i>
                Nouveau lieu
            </h1>
            <div class="breadcrumb">
                <a href="{{ path('app_main') }}">Accueil</a>
                <i class="bi bi-chevron-right"></i>
                <a href="{{ path('app_place_index') }}">Lieux</a>
                <i class="bi bi-chevron-right"></i>
                <span>Nouveau</span>
            </div>
        </div>
        <a href="{{ path('app_place_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Retour à la liste
        </a>
    </div>
    
    <div class="admin-card">
        <div class="admin-card-header">
            <h3><i class="bi bi-building"></i> Informations du lieu</h3>
        </div>
        <div class="admin-card-body">
            {{ include('back/place/_form.html.twig') }}
        </div>
    </div>
{% endblock content %}
