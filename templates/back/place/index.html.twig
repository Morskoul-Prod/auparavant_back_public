{% extends 'base.html.twig' %}

{% block title %}Lieux — Auparavant Admin{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-building"></i>
                Lieux
            </h1>
            <div class="breadcrumb">
                <a href="{{ path('app_main') }}">Accueil</a>
                <i class="bi bi-chevron-right"></i>
                <span>Lieux</span>
            </div>
        </div>
        <a href="{{ path('app_place_new') }}" class="btn-add">
            <i class="bi bi-plus-lg"></i>
            Nouveau lieu
        </a>
    </div>
    
    <div class="admin-card">
        <div class="admin-card-header">
            <h3><i class="bi bi-list-ul"></i> Liste des lieux</h3>
            <span class="badge badge-warning">{{ places|length }} lieu(x)</span>
        </div>
        <div class="admin-card-body" style="padding: 0;">
            {% if places is not empty %}
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;">ID</th>
                            <th>Nom</th>
                            <th>Type</th>
                            <th>Adresse</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for place in places %}
                            <tr>
                                <td><span class="badge badge-primary">#{{ place.id }}</span></td>
                                <td><strong>{{ place.name|default('Sans nom') }}</strong></td>
                                <td><span class="badge badge-warning">{{ place.type.label|default('—') }}</span></td>
                                <td>
                                    {% if place.location %}
                                        {{ place.location.street }}
                                        <br><small style="color: var(--text-muted);">{{ place.location.zipcode }} {{ place.location.city }}</small>
                                    {% else %}
                                        <span style="color: var(--text-muted);">Aucune adresse</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="{{ path('app_place_show', {'id': place.id}) }}" class="btn btn-icon btn-secondary" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('app_place_edit', {'id': place.id}) }}" class="btn btn-icon btn-warning" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-building"></i>
                    <h4>Aucun lieu</h4>
                    <p>Ajoutez votre premier point d'intérêt</p>
                    <a href="{{ path('app_place_new') }}" class="btn-add">
                        <i class="bi bi-plus-lg"></i>
                        Créer un lieu
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock content %}
