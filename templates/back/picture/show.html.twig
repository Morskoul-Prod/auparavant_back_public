{% extends 'base.html.twig' %}

{% block title %}Image #{{ picture.id }} — Auparavant Admin{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-image"></i>
                Image #{{ picture.id }}
            </h1>
            <div class="breadcrumb">
                <a href="{{ path('app_main') }}">Accueil</a>
                <i class="bi bi-chevron-right"></i>
                <a href="{{ path('app_picture_index') }}">Images</a>
                <i class="bi bi-chevron-right"></i>
                <span>#{{ picture.id }}</span>
            </div>
        </div>
        <div class="action-buttons">
            <a href="{{ path('app_picture_edit', {'id': picture.id}) }}" class="btn btn-warning">
                <i class="bi bi-pencil"></i>
                Modifier
            </a>
            <a href="{{ path('app_picture_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Retour
            </a>
        </div>
    </div>
    
    <div class="d-flex gap-2" style="flex-wrap: wrap;">
        <!-- Aperçu -->
        <div class="admin-card" style="flex: 0 0 350px;">
            <div class="admin-card-header">
                <h3><i class="bi bi-image"></i> Aperçu</h3>
            </div>
            <div class="admin-card-body text-center">
                {% if picture.imageName %}
                    <img src="{{ picture.imageUrl }}" class="img-preview" alt="Photo" style="width: 100%; height: auto; max-height: 400px;">
                {% else %}
                    <div class="empty-state" style="padding: 2rem;">
                        <i class="bi bi-image"></i>
                        <p>Aucune image</p>
                    </div>
                {% endif %}
            </div>
        </div>
        
        <!-- Informations -->
        <div class="admin-card" style="flex: 1; min-width: 300px;">
            <div class="admin-card-header">
                <h3><i class="bi bi-info-circle"></i> Informations</h3>
            </div>
            <div class="admin-card-body">
                <table class="admin-table" style="margin: -1.5rem;">
                    <tbody>
                        <tr>
                            <th style="width: 150px;">ID</th>
                            <td><span class="badge badge-primary">#{{ picture.id }}</span></td>
                        </tr>
                        <tr>
                            <th>Nom du fichier</th>
                            <td><code style="color: var(--accent);">{{ picture.imageName|default('—') }}</code></td>
                        </tr>
                        <tr>
                            <th>Type</th>
                            <td>
                                <span class="badge bg-secondary">
                                    {{ picture.type == 'other' ? 'Autre' : picture.type }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>Position</th>
                            <td>{{ picture.position }}</td>
                        </tr>
                        <tr>
                            <th>Titulaire des droits</th>
                            <td>{{ picture.copyrightHolder|default('—') }}</td>
                        </tr>
                        <tr>
                            <th>Créée le</th>
                            <td>{{ picture.createdAt ? picture.createdAt|date('d/m/Y à H:i') : '—' }}</td>
                        </tr>
                        <tr>
                            <th>Modifiée le</th>
                            <td>{{ picture.updatedAt ? picture.updatedAt|date('d/m/Y à H:i') : '—' }}</td>
                        </tr>
                        <tr>
                            <th>Souvenir associé</th>
                            <td>
                                {% if picture.memory %}
                                    <a href="{{ path('app_memory_show', {'id': picture.memory.id}) }}" class="btn btn-sm btn-secondary">
                                        <i class="bi bi-camera-reels"></i>
                                        {{ picture.memory.title|default('Souvenir #' ~ picture.memory.id) }}
                                    </a>
                                {% else %}
                                    <span style="color: var(--text-muted);">Non associée</span>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <!-- Zone de danger -->
    <div class="admin-card mt-3" style="border-color: rgba(139, 0, 0, 0.3);">
        <div class="admin-card-header" style="background: rgba(139, 0, 0, 0.1);">
            <h3 style="color: #CD5C5C;"><i class="bi bi-exclamation-triangle"></i> Zone de danger</h3>
        </div>
        <div class="admin-card-body">
            <p style="color: var(--text-secondary); margin-bottom: 1rem;">
                La suppression de cette image est irréversible.
            </p>
            {{ include('back/picture/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock content %}