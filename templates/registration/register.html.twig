{% extends 'base.html.twig' %}

{% block title %}Inscription — Auparavant Admin{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <img src="{{ asset('css/pictures/appareilphotovintage.png') }}" alt="Auparavant" class="auth-logo">
                <h1>Créer un compte</h1>
                <p>Rejoignez Auparavant Admin</p>
            </div>
            
            <div class="auth-body">
                {{ form_start(registrationForm) }}
                    {{ form_errors(registrationForm) }}
                    
                    <div class="form-group">
                        {{ form_label(registrationForm.pseudonym) }}
                        {{ form_widget(registrationForm.pseudonym) }}
                        {{ form_errors(registrationForm.pseudonym) }}
                    </div>
                    
                    <div class="form-group">
                        {{ form_label(registrationForm.email) }}
                        {{ form_widget(registrationForm.email) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>
                    
                    <div class="form-group">
                        {{ form_label(registrationForm.plainPassword) }}
                        {{ form_widget(registrationForm.plainPassword) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>
                    
                    <div class="form-group" style="display: flex; align-items: center; gap: 0.75rem;">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'style': 'margin: 0; cursor: pointer;'}}) }}
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}

                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 1.5rem;">
                        <i class="bi bi-person-plus"></i>
                        S'inscrire
                    </button>
                {{ form_end(registrationForm) }}
            </div>
            
            <div class="auth-footer">
                <p>Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
