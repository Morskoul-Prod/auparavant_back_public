{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — Auparavant Admin{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <img src="{{ asset('css/pictures/appareilphotovintage.png') }}" alt="Auparavant" class="auth-logo">
                <h1>Nouveau mot de passe</h1>
                <p>Choisissez un nouveau mot de passe sécurisé</p>
            </div>
            
            <div class="auth-body">
                {{ form_start(resetForm) }}
                    <div class="form-group">
                        {{ form_label(resetForm.plainPassword.first) }}
                        {{ form_widget(resetForm.plainPassword.first) }}
                        {{ form_errors(resetForm.plainPassword.first) }}
                    </div>
                    
                    <div class="form-group">
                        {{ form_label(resetForm.plainPassword.second) }}
                        {{ form_widget(resetForm.plainPassword.second) }}
                        {{ form_errors(resetForm.plainPassword.second) }}
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 1rem;">
                        <i class="bi bi-shield-check"></i>
                        Réinitialiser le mot de passe
                    </button>
                {{ form_end(resetForm) }}
            </div>
            
            <div class="auth-footer">
                <p><a href="{{ path('app_login') }}"><i class="bi bi-arrow-left"></i> Retour à la connexion</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
