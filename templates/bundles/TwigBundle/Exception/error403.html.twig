{% extends 'base.html.twig' %}

{% block body %}
<div class="my-5 py-5 text-center">
<h1>Accès interdit</h1>
{% if app.user and not is_granted('ROLE_MODERATOR') %}
<p>Votre compte n'a pas encore de droits sur le back-office.</p>
<p>Un administrateur doit vous attribuer un rôle avant que vous puissiez y accéder.</p>
{% else %}
<p>Vous n'avez pas les droits pour accéder à cette page.</p>
{% endif %}
<div class="d-flex justify-content-center">
<div class="tenor-gif-embed" data-postid="25238180" data-share-method="host" data-aspect-ratio="1.77778" data-width="49%"><a href="https://tenor.com/view/youre-not-coming-in-benjamin-engvid-halt-stop-right-there-gif-25238180">Youre Not Coming In Benjamin GIF</a>from <a href="https://tenor.com/search/youre+not+coming+in-gifs">Youre Not Coming In GIFs</a></div>
</div>
