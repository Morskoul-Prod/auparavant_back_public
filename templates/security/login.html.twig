{% extends 'base.html.twig' %}

{% block title %}Connexion — Auparavant Admin
{% endblock %}

{% block body %}
	<div class="auth-wrapper">
		<div class="auth-container">
			<div class="auth-card">
				<div class="auth-header">
					<img src="{{ asset('css/pictures/appareilphotovintage.png') }}" alt="Auparavant" class="auth-logo">
					<h1>Auparavant</h1>
					<p>Interface d'administration</p>
				</div>

				<div class="auth-body">
					{% if error %}
						<div class="alert alert-danger">
							<i class="bi bi-exclamation-triangle"></i>
							{{ error.messageKey|trans(error.messageData, 'security') }}
						</div>
					{% endif %}

					<form method="post">
						<div class="form-group">
							<label for="inputEmail">
								<i class="bi bi-envelope"></i>
								Adresse email
							</label>
							<input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" placeholder="votre@email.com" autocomplete="email" autofocus required>
						</div>

						<div class="form-group">
							<label for="inputPassword">
								<i class="bi bi-lock"></i>
								Mot de passe
							</label>
							<input type="password" name="password" id="inputPassword" class="form-control" placeholder="••••••••" autocomplete="current-password" required>
						</div>

						<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

						<button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 1rem;">
							<i class="bi bi-box-arrow-in-right"></i>
							Se connecter
						</button>
					</form>

					<div class="auth-divider">
						<span>ou</span>
					</div>

					<a href="{{ path('app_forgot_password_request') }}" class="btn btn-secondary" style="width: 100%;">
						<i class="bi bi-key"></i>
						Mot de passe oublié ?
					</a>
				</div>

				<div class="auth-footer">
					<p>Pas encore de compte ?
						<a href="{{ path('app_register') }}">Créer un compte</a>
					</p>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
