# Valeurs par défaut, sans aucun secret.
# Renseigner les vraies valeurs dans .env.local (non versionné).

APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8000

DATABASE_URL="mysql://utilisateur:motdepasse@127.0.0.1:3306/auparavant_back?serverVersion=8.0.32&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Brevo : brevo+api://CLE@default
MAILER_DSN=null://null

# Clés générées avec : php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
JWT_TTL=600

CORS_ALLOWED_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SECURE=false
FRONT_URL=http://localhost:5173
